PORT=3001
NODE_ENV=development
DATABASE_URL="postgresql://gabinete:gabinete@localhost:5432/gabinete_dev"
JWT_ACCESS_SECRET="troque-por-um-segredo-aleatorio-de-32-caracteres"
# Reservado: o refresh token atual é opaco (hash SHA-256 no banco), não um JWT.
# Ainda obrigatório na validação de env para não quebrar ambientes já provisionados.
JWT_REFRESH_SECRET="troque-por-outro-segredo-aleatorio-de-32-caracteres"
FRONTEND_URL="http://localhost:3000"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# SameSite do cookie httpOnly de refresh token.
# "lax" serve para desenvolvimento (frontend e backend em localhost = mesmo site).
# Em produção com frontend e backend em DOMÍNIOS DIFERENTES (Vercel + Render), o navegador
# não envia cookies "lax" nas chamadas cross-site — /auth/refresh e /auth/logout quebram.
# Nesse cenário use "none" (o backend força Secure=true automaticamente, exigido pelo padrão).
COOKIE_SAME_SITE="lax"
